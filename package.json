{
  "name": "huurmonitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:corrections": "tsx --test tests/state.test.ts tests/parsers.test.ts tests/private-load.test.ts",
    "test:scan": "tsx --test tests/inventory.test.ts tests/parsers.test.ts tests/state.test.ts",
    "check": "tsc --noEmit && vite build",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "cheerio": "^1.1.2",
    "maplibre-gl": "^6.18.0",
    "nodemailer": "^10.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
