# Browser: public configuration only. No service/admin keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public browser key: own free CARTO basemap key, origin-restricted.
# Separate localhost and production keys. No key means list-only map fallback.
VITE_CARTO_BASEMAPS_KEY=
# New sb_publishable_ preferred; legacy anon JWT supported, service_role rejected.

# Worker only. All external effects disabled until explicitly configured.
ENABLE_MONITORING=false
SOURCE_ALLOWLIST=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=
ENABLE_EMAIL=false
# Explicit transport; no automatic provider fallback. Gmail is the selected route.
EMAIL_TRANSPORT=gmail
# Worker only: enable Google 2-Step Verification, create an app password, then
# enter it locally (16 characters; Google's grouping spaces are accepted).
# Never use your normal Google password or put either value in VITE_* / chat.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative only when EMAIL_TRANSPORT=resend; ignored by Gmail transport.
RESEND_API_KEY=
EMAIL_FROM=
